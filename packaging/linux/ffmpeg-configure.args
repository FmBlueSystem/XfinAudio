--disable-everything
--disable-autodetect
--disable-network
--disable-doc
--disable-debug
--disable-x86asm
--disable-shared
--enable-static
--disable-ffplay
--disable-ffprobe
--enable-ffmpeg
--enable-protocol=file,pipe
--enable-demuxer=aiff,flac,mp3,mov,wav
--enable-decoder=aac,alac,flac,mp3,mp3float,pcm_s8,pcm_u8,pcm_s16be,pcm_s16le,pcm_s24be,pcm_s24le,pcm_s32be,pcm_s32le,pcm_f32be,pcm_f32le,pcm_f64be,pcm_f64le
--enable-parser=aac,flac,mpegaudio
--enable-filter=ebur128,abuffer,abuffersink,aformat,anull,aresample
--enable-muxer=null,pcm_s16le
--enable-encoder=pcm_s16le
